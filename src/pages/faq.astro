---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: "Comment acheter une pièce ?",
    a: "Chaque pièce étant unique, tout commence par un échange direct : un message WhatsApp, un appel au 06 25 37 17 57 ou un email à contact@cabinetdescuriosites.com. Le paiement (virement, ou espèces lors du retrait) et le mode de remise sont convenus ensemble, simplement et rapidement.",
  },
  {
    q: "Comment se passe la livraison ?",
    a: "Chaque pièce est préparée à la main à Lyon : nettoyée, protégée selon sa matière et sa fragilité, puis expédiée sous 48 h après réception du paiement, en point relais Mondial Relay ou à domicile. Le tarif dépend de la taille et du poids de l’objet et vous est confirmé avant la vente.",
  },
  {
    q: "Puis-je retirer mon achat à Lyon ?",
    a: "Oui, gratuitement. Le retrait se fait sur rendez-vous à Lyon 1er, au 16 rue de l’Arbre Sec : l’occasion de découvrir la pièce en vrai avant de l’emporter.",
  },
  {
    q: "Et si l'objet ne me convient pas ?",
    a: "Chaque pièce est décrite avec précision (état détaillé, dimensions, photos fidèles) pour éviter toute surprise. Si, à réception, l’objet ne correspond pas à sa description, prévenez-nous sous 14 jours : le retour est organisé ensemble et la pièce remboursée dès sa récupération.",
  },
  {
    q: "Les objets sont-ils vraiment uniques ?",
    a: "Oui. Chaque pièce existe en un seul exemplaire, chinée puis sélectionnée une à une. Lorsqu’elle est partie, elle l’est pour de bon : un coup de cœur ne se remet pas à plus tard.",
  },
  {
    q: "Proposez-vous d'autres services ?",
    a: "Oui. Au-delà de la boutique : la recherche d’objet sur demande (Personal Chineur), le dépôt-vente de vos belles pièces, le vide-maison (greniers, caves, granges, quel que soit le volume) et des ateliers rénovation en petit groupe.",
  },
  {
    q: "Vous cherchez un objet précis ?",
    a: "C’est le service Personal Chineur : décrivez la pièce dont vous rêvez (une photo d’inspiration suffit) et la recherche se poursuit au fil des chines, jusqu’à la dénicher pour vous.",
  },
];
---
<Layout
  title="FAQ — Cabinet des Curiosités"
  description="Achat, livraison soignée, retrait à Lyon, retours : les réponses aux questions les plus fréquentes du Cabinet des Curiosités."
  active="faq"
  inner={true}
>
  <section class="inner-intro inner-intro--faq">
    <div class="wrap inner-intro__inner">
      <span class="eyebrow">Questions fréquentes</span>
      <div class="inner-intro__grid">
        <h1>Tout ce que vous<br /><em>vous demandez.</em></h1>
        <p>Achat, livraison, retrait à Lyon, retours : l’essentiel est ici. Pour le reste, une réponse personnelle, par téléphone ou par écrit.</p>
      </div>
    </div>
  </section>

  <section class="faq-page">
    <div class="wrap faq-page__inner">
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}<span aria-hidden="true">+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <aside class="faq-page__more">
        <p>Une autre question ? Stéfani vous répond directement.</p>
        <div class="faq-page__links">
          <a href="tel:+33625371757" class="btn btn--solid">06 25 37 17 57</a>
          <a href="/contact" class="btn">Écrire un message</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
