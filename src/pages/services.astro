---
import Layout from '../layouts/Layout.astro';

const wa = (msg: string) => `https://wa.me/33625371757?text=${encodeURIComponent(msg)}`;

const services = [
  {
    n: "01",
    cle: "chiner",
    eyebrow: "Chiner pour vous",
    titre: "Votre<br /><em>Personal Chineur.</em>",
    texte: [
      "Une lampe des années 50, un pichet publicitaire, la table basse aperçue dans un magazine : un objet précis vous manque, mais le temps ou les occasions font défaut pour le trouver. Le Cabinet part le chercher pour vous.",
      "Décrivez la pièce : une époque, une matière, une photo d’inspiration suffisent. La recherche se poursuit au fil des chines, jusqu’à la trouvaille qui correspond vraiment.",
    ],
    tarif: "Selon le prix de l’objet et le temps de recherche",
    delai: "Variable — le temps qu’il faut pour trouver la bonne pièce",
    image: "/assets/personal-chineur-pentes-v2.webp",
    alt: "Brocante sur les pentes pavées de la Croix-Rousse à Lyon, sans silhouette au premier plan",
    cta: "Confier une recherche",
    msg: "Bonjour Stéfani, j’aimerais vous confier la recherche d’un objet.",
  },
  {
    n: "02",
    cle: "atelier",
    eyebrow: "Atelier rénovation",
    titre: "Redonner une seconde vie<br /><em>à ce qui vous tient à cœur.</em>",
    texte: [
      "Des ateliers en tout petit groupe, quelques heures pour apprendre les gestes justes : nettoyer, réparer, patiner, et redonner à vos objets l’éclat qu’ils méritent.",
      "Vous préférez confier la pièce ? Du simple relooking à la restauration complète, elle est prise en charge avec le même soin que les objets de la collection.",
    ],
    tarif: "Selon les travaux : du relooking à la restauration complète",
    delai: "Atelier de quelques heures · restauration sur devis",
    image: "/assets/atelier-renovation-geste-v5.webp",
    alt: "Gros plan sur les mains de Stéfani rénovant la garniture d’un fauteuil ancien",
    cta: "Participer à un atelier",
    msg: "Bonjour Stéfani, je suis intéressé·e par un atelier rénovation.",
  },
  {
    n: "03",
    cle: "depot",
    eyebrow: "Dépôt-vente",
    titre: "Vos coups de cœur d’hier<br /><em>méritent un nouveau regard.</em>",
    texte: [
      "Ces belles pièces qui ne trouvent plus leur place chez vous méritent un nouveau regard. Le Cabinet prend tout en charge : sélection, mise en valeur, photographies et mise en vente de vos objets et de votre mobilier des années 1920 à 1980.",
      "Vous êtes informé·e de chaque vente et réglé·e dès qu’elle est conclue. Une manière simple et élégante de transmettre ce que vous avez aimé.",
    ],
    tarif: "Commission de 30 % sur le prix de vente",
    delai: "Contrat de dépôt établi ensemble · paiement après la vente",
    image: "/assets/depot-vente-mains-v8.webp",
    alt: "Stéfani soulève un pichet ancien au-dessus de cartons remplis de vases et de lampes, prêts pour le dépôt-vente",
    cta: "Proposer un objet",
    msg: "Bonjour Stéfani, je souhaite vous proposer un objet en dépôt-vente.",
  },
  {
    n: "04",
    cle: "vide-maison",
    eyebrow: "Vide-maison",
    titre: "Un lieu à vider,<br /><em>des trésors à sauver.</em>",
    texte: [
      "Maison, appartement, grenier, cave ou grange : le Cabinet organise le débarras complet, quel que soit le volume, en prenant soin de tout ce qui peut encore vivre.",
      "Les objets anciens qui dorment chez vous, à l’intérieur comme à l’extérieur, peuvent aussi être simplement récupérés, sans débarras complet.",
    ],
    tarif: "Forfait établi après estimation des objets récupérés",
    delai: "Date convenue ensemble · acompte de 30 % à la commande",
    image: "/assets/vide-maison-cartons-v3.webp",
    alt: "Cartons, vaisselle, cadres et objets anciens prêts à être triés dans un appartement lyonnais",
    cta: "Organiser un débarras",
    msg: "Bonjour Stéfani, j’aimerais organiser un vide-maison.",
  },
];
---
<Layout
  title="Services — Cabinet des Curiosités"
  description="Personal Chineur, atelier rénovation, dépôt-vente et vide-maison : quatre façons de faire vivre les objets anciens, à Lyon."
  active="services"
  inner={true}
>
  <section class="inner-intro inner-intro--services">
    <div class="wrap inner-intro__inner">
      <span class="eyebrow">Les services</span>
      <div class="inner-intro__grid">
        <h1>Chiner, restaurer,<br /><em>transmettre.</em></h1>
        <p>Au-delà de la boutique, le Cabinet accompagne vos objets à chaque étape de leur histoire : rechercher la pièce qui vous manque, restaurer celle qui compte, vendre celles dont vous vous séparez, ou vider un lieu avec soin.</p>
      </div>
      <nav class="inner-intro__foot" aria-label="Accès rapide aux services">
        {services.map((s) => <a href={`#${s.cle}`}>{s.n} · {s.eyebrow}</a>)}
      </nav>
    </div>
  </section>

  {services.map((s, i) => (
    <section class={`svc${i % 2 === 1 ? " svc--reverse" : ""}`} id={s.cle}>
      <div class="svc__media">
        <img src={s.image} alt={s.alt} loading="lazy" />
      </div>
      <div class="svc__panel">
        <span class="svc__num" aria-hidden="true">{s.n}</span>
        <span class="croquis svc__croquis" data-croquis={s.cle} aria-hidden="true"></span>
        <span class="eyebrow">{s.eyebrow}</span>
        <h2 set:html={s.titre} />
        {s.texte.map((t) => <p>{t}</p>)}
        <dl class="svc__facts">
          <div><dt>Tarif</dt><dd>{s.tarif}</dd></div>
          <div><dt>Déroulé</dt><dd>{s.delai}</dd></div>
        </dl>
        <a href={wa(s.msg)} class="btn btn--solid" target="_blank" rel="noopener noreferrer">{s.cta}</a>
      </div>
    </section>
  ))}

  <section class="svc-contact">
    <div class="wrap svc-contact__grid">
      <div class="svc-contact__intro">
        <span class="svc-contact__seal" aria-hidden="true">C<em>D</em>C</span>
        <span class="eyebrow">Parlons-en</span>
        <h2>Un projet<br /><em>en tête ?</em></h2>
        <p class="svc-contact__hand">Décrivez-le simplement : réponse personnelle sous 24 à 48 heures.</p>
      </div>
      <div class="svc-contact__ways">
        <a class="svc-way" href="tel:+33625371757">
          <span class="svc-way__label">Par téléphone</span>
          <strong class="svc-way__value">06 25 37 17 57</strong>
          <span class="svc-way__note">Le plus direct, de vive voix</span>
          <em class="svc-way__arrow" aria-hidden="true">→</em>
        </a>
        <a class="svc-way" href={wa("Bonjour Stéfani, j’ai un projet en tête et j’aimerais vous en parler.")} target="_blank" rel="noopener noreferrer">
          <span class="svc-way__label">Sur WhatsApp</span>
          <strong class="svc-way__value">Envoyer un message</strong>
          <span class="svc-way__note">Pratique pour joindre une photo</span>
          <em class="svc-way__arrow" aria-hidden="true">→</em>
        </a>
        <a class="svc-way" href="mailto:contact@cabinetdescuriosites.com">
          <span class="svc-way__label">Par email</span>
          <strong class="svc-way__value">contact@cabinetdescuriosites.com</strong>
          <span class="svc-way__note">Pour les demandes détaillées</span>
          <em class="svc-way__arrow" aria-hidden="true">→</em>
        </a>
      </div>
    </div>
  </section>
</Layout>
