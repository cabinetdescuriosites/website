---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact — Cabinet des Curiosités" active="contact" inner={true}>
  <section class="contact-cinema" aria-labelledby="contact-title">
    <div class="contact-cinema__image">
      <img src="/assets/contact-correspondance-stefani-v1.webp" alt="Les mains tatouées de Stéfani écrivant un mot près d’un téléphone vintage" />
    </div>
    <div class="contact-cinema__veil"></div>
    <div class="wrap contact-cinema__inner">
      <div class="contact-cinema__card reveal">
        <span class="eyebrow">Un échange direct</span>
        <h1 id="contact-title">Une pièce vous intrigue ?<br />Parlons-en simplement.</h1>
        <p>Une question, un objet à me confier ou l’envie d’en savoir plus ? Je lis chaque message et je vous réponds personnellement.</p>
        <div class="contact-cinema__links">
          <a href="mailto:contact@cabinetdescuriosites.com">
            <span>Écrire par email</span>
            <strong>contact@cabinetdescuriosites.com</strong>
            <em aria-hidden="true">↗</em>
          </a>
          <a href="https://instagram.com/brocaddict.cafe" target="_blank" rel="noopener noreferrer">
            <span>Suivre les trouvailles</span>
            <strong>@brocaddict.cafe</strong>
            <em aria-hidden="true">↗</em>
          </a>
        </div>
      </div>
    </div>
    <span class="contact-cinema__side">Objets · histoires · échanges</span>
  </section>
</Layout>
