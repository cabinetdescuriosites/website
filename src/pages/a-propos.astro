---
import Layout from '../layouts/Layout.astro';
const values = [
  { n: "01", t: "Regarder longtemps", p: "Une forme juste, une matière honnête, une patine qui raconte sans tricher : l’œil se construit avec le temps." },
  { n: "02", t: "Choisir peu", p: "Chaque objet entre seul dans la collection. Il doit avoir une présence propre et pouvoir vivre dans un intérieur actuel." },
  { n: "03", t: "Transmettre avec soin", p: "Description sincère, conseils disponibles et emballage adapté : l’attention continue après la chine." },
];
---
<Layout title="À propos — Cabinet des Curiosités" active="apropos" inner={true}>
  <section class="pagehero">
    <div class="pagehero__bg"><img src="/assets/vignette-2.jpg" alt="" /></div>
    <div class="pagehero__in">
      <span class="eyebrow">Notre histoire</span>
      <h1>Une histoire de regard</h1>
      <p>Quarante ans à observer les objets, leurs usages, leurs matières — et à reconnaître ceux qui méritent une nouvelle histoire.</p>
    </div>
  </section>

  <!-- FONDATRICE — panneau + monogramme gravé -->
  <section class="founder">
    <div class="founder__panel reveal">
      <span class="founder__seal" aria-hidden="true">C<em>D</em>C</span>
      <div class="founder__portrait"><img src="/assets/fondatrice-3.jpg" alt="Stéphanie, fondatrice" /></div>
      <div class="founder__txt">
        <span class="eyebrow">La fondatrice</span>
        <h2>Des décennies à former<br>un regard personnel.</h2>
        <p>Stéphanie chine depuis près de quarante ans. D’abord pour elle, pour ses proches et pour le plaisir de composer des maisons vivantes ; puis avec l’envie de partager cette sélection plus largement.</p>
        <p>Son terrain de prédilection va de 1900 aux années 1980 : grès, verre, mobilier, objets d’usage et curiosités dont la qualité se révèle dans les détails.</p>
      </div>
    </div>
    <div class="founder__photo reveal"><img src="/assets/still-1.jpg" alt="L'atelier" /></div>
  </section>

  <!-- CITATION — ancre sombre -->
  <section class="quote">
    <img class="quote__leaf" src="/assets/il-bouquet.png" alt="" />
    <div class="wrap reveal">
      <span class="quote__mark">“</span>
      <blockquote>Je choisis ce que j’aimerais garder — jamais ce qu’il faudrait simplement vendre.</blockquote>
      <div class="quote__by">Stéphanie · Fondatrice</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-head reveal"><span class="eyebrow">Ce qui nous guide</span><h2>Nos valeurs</h2></div>
      <div class="values">
        {values.map((v) => (
          <div class="value reveal"><div class="rule"></div><div class="num">{v.n}</div><h3>{v.t}</h3><p>{v.p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-years">
    <div class="wrap about-years__grid">
      <div class="about-years__intro reveal">
        <span class="eyebrow">Les repères</span>
        <h2>Une histoire qui se compte moins en dates qu’en objets rencontrés.</h2>
      </div>
      <div class="about-years__list">
        <article class="reveal"><span>Depuis près de</span><strong>40 ans</strong><p>de marchés, brocantes, maisons vidées et rencontres avec celles et ceux qui transmettent.</p></article>
        <article class="reveal"><span>Une préférence pour</span><strong>1900—1980</strong><p>une période riche en matières, savoir-faire et formes pensées pour durer.</p></article>
        <article class="reveal"><span>Pour chaque pièce</span><strong>1 choix</strong><p>regarder, documenter, nettoyer, photographier et décrire avec sincérité.</p></article>
      </div>
    </div>
  </section>

  <section class="about-care">
    <div class="about-care__image reveal"><img src="/assets/packaging-stephanie.jpg" alt="Stéphanie préparant soigneusement une céramique pour son envoi" /></div>
    <div class="about-care__copy reveal">
      <span class="eyebrow">Avant de vous parvenir</span>
      <h2>Le soin fait partie de l’objet.</h2>
      <p>Stéphanie prépare elle-même chaque commande. Elle adapte les protections à la matière et à la fragilité de la pièce, soigne la présentation et ajoute cette attention qui transforme un colis en véritable réception.</p>
      <a href="/contact" class="tlink">Échanger avec Stéphanie</a>
    </div>
  </section>
</Layout>
