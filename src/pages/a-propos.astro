---
import Layout from '../layouts/Layout.astro';
const values = [
  { n: "01", t: "Écouter ce que l’objet raconte", p: "Une forme, une matière, une trace laissée par le temps : je cherche la présence avant la perfection." },
  { n: "02", t: "Choisir avec conviction", p: "Je préfère une pièce qui remue quelque chose à dix objets simplement jolis. Chaque choix doit pouvoir être défendu et raconté." },
  { n: "03", t: "Transmettre vraiment", p: "Je décris chaque objet avec sincérité, je partage ce que j’en sais et je le prépare comme si je le confiais en main propre." },
];
---
<Layout title="À propos — Cabinet des Curiosités" active="apropos" inner={true}>
  <section class="inner-intro inner-intro--about">
    <div class="wrap inner-intro__inner">
      <span class="eyebrow">Mon histoire · le regard de Stéfani</span>
      <div class="inner-intro__grid">
        <h1>Quarante ans à regarder<br /><em>autrement.</em></h1>
        <p>Avec le temps, j’ai appris à reconnaître ce que l’on ne fabrique plus : une matière honnête, une ligne juste et cette patine que seule une vie peut déposer.</p>
      </div>
      <div class="inner-intro__foot" aria-label="Repères">
        <span>Objets de 1900 aux années 1980</span>
        <span>Choisis un à un, à Lyon</span>
      </div>
    </div>
  </section>

  <!-- FONDATRICE — panneau + monogramme gravé -->
  <section class="founder">
    <div class="founder__panel reveal">
      <div class="founder__portrait"><img src="/assets/fondatrice-stefani-blonde-brocante-v3.webp" alt="Stéfani, blonde et tatouée, examinant un objet ancien dans une brocante" /></div>
      <div class="founder__txt">
        <span class="eyebrow">La fondatrice</span>
        <h2>Je ne cherche pas le parfait.<br>Je cherche la présence.</h2>
        <p>Ce qui a commencé comme une passion intime est devenu une manière de regarder le monde : ralentir, toucher les matières, reconnaître un geste et sentir immédiatement lorsqu’une pièce mérite d’être défendue.</p>
        <p>J’aime particulièrement les objets de 1900 aux années 1980 — grès, verre, mobilier, objets d’usage et curiosités — parce qu’ils portent les traces d’une époque sans cesser de parler à nos maisons d’aujourd’hui.</p>
      </div>
    </div>
    <div class="founder__photo reveal"><img src="/assets/still-1.jpg" alt="L'atelier" /></div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-head reveal"><span class="eyebrow">Ce qui me guide</span><h2>Mes engagements</h2></div>
      <div class="values">
        {values.map((v) => (
          <div class="value reveal"><div class="rule"></div><div class="num">{v.n}</div><h3>{v.t}</h3><p>{v.p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-film" aria-labelledby="film-title">
    <div class="about-film__image">
      <img src="/assets/van-open.jpg" alt="Le van du Cabinet des Curiosités ouvert au milieu d’une sélection d’objets" loading="lazy" />
    </div>
    <div class="about-film__veil"></div>
    <div class="about-film__content reveal">
      <span class="about-film__play" aria-hidden="true">▶</span>
      <span class="eyebrow">Le Cabinet en images</span>
      <h2 id="film-title">Entrez dans<br />mon univers.</h2>
      <p>Je veux vous montrer la chine telle que je la vis : les gestes, les rencontres et cette émotion qui décide de tout.</p>
      <small>Film de présentation · bientôt</small>
    </div>
  </section>

</Layout>
