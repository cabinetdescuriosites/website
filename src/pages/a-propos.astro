---
import Layout from '../layouts/Layout.astro';
const values = [
  { n: "01", t: "Chiner avec l'œil", p: "Chaque pièce est choisie à la main, pour sa qualité, sa patine et son caractère. Jamais en série." },
  { n: "02", t: "Transmettre avec soin", p: "Restauration douce, emballage soigné, conseils sincères. L'objet arrive prêt à être aimé." },
  { n: "03", t: "Échanger en confiance", p: "Une relation simple et honnête, de la première question à la livraison." },
];
---
<Layout title="À propos — Cabinet des Curiosités" active="apropos" inner={true}>
  <section class="pagehero">
    <div class="pagehero__bg"><img src="/assets/vignette-2.jpg" alt="" /></div>
    <div class="pagehero__in">
      <span class="eyebrow">Notre histoire</span>
      <h1>La passion de la chine</h1>
      <p>Il était une fois une envie : dénicher des pépites, des perles rares et des objets de curiosité.</p>
    </div>
  </section>

  <!-- FONDATRICE — panneau + monogramme gravé -->
  <section class="founder">
    <div class="founder__panel reveal">
      <span class="founder__seal" aria-hidden="true">C<em>D</em>C</span>
      <div class="founder__portrait"><img src="/assets/fondatrice-3.jpg" alt="Stéphanie, fondatrice" /></div>
      <div class="founder__txt">
        <span class="eyebrow">La fondatrice</span>
        <h2>Chiner, mon passe-temps<br>favori devenu métier.</h2>
        <p>De brocante en vide-grenier, la recherche du bel objet est devenue une passion, puis une vocation. Choisir, restaurer et transmettre des pièces qui ont une âme.</p>
        <p>Chaque échange se construit comme une recette de cuisine — avec « amour », dans une relation de confiance, d'écoute et de partage.</p>
      </div>
    </div>
    <div class="founder__photo reveal"><img src="/assets/still-1.jpg" alt="L'atelier" /></div>
  </section>

  <!-- CITATION — ancre sombre -->
  <section class="quote">
    <img class="quote__leaf" src="/assets/il-bouquet.png" alt="" />
    <div class="wrap reveal">
      <span class="quote__mark">“</span>
      <blockquote>L'objet rare mérite un regard juste.</blockquote>
      <div class="quote__by">Notre devise</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-head reveal"><span class="eyebrow">Ce qui nous guide</span><h2>Nos valeurs</h2></div>
      <div class="values">
        {values.map((v) => (
          <div class="value reveal"><div class="rule"></div><div class="num">{v.n}</div><h3>{v.t}</h3><p>{v.p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- CARAVANE — photo + panneau dessin -->
  <section class="cvn">
    <div class="cvn__photo reveal"><img src="/assets/van-field.jpg" alt="La caravane vintage" /></div>
    <div class="cvn__panel reveal">
      <div class="cvn__label">La caravane</div>
      <h2>Au gré<br>des brocantes</h2>
      <img class="cvn__draw" src="/assets/il-caravan.png" alt="Illustration de la caravane" />
      <p>Retrouvez la caravane sur les marchés et salons de la région lyonnaise, et venez chiner en vrai.</p>
      <a href="/contact" class="tlink">Nous écrire</a>
    </div>
  </section>
</Layout>
