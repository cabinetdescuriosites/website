---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const produits = (await getCollection("produits"))
  .filter((p) => p.data.statut !== "Vendu")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const cover = (p) => p.data.photos[0] ?? "/assets/placeholder.svg";
const cats = [
  { l: "Céramique", img: "ceramique.jpg" },
  { l: "Verrerie", img: "verrerie.jpg" },
  { l: "Mobilier", img: "mobilier.jpg" },
];
---
<Layout title="Cabinet des Curiosités — L'objet rare mérite un regard juste" active="home">

  <!-- HERO — BANNIÈRE ÉDITORIALE -->
  <section class="home-hero">
    <div class="home-hero__image">
      <img src="/assets/van-open.jpg" alt="Le van du Cabinet des Curiosités installé au cœur de la nature" />
    </div>
    <div class="home-hero__veil"></div>
    <h1 class="visually-hidden">Cabinet des Curiosités — objets chinés et pièces uniques</h1>
    <a href="#manifeste" class="home-hero__discover" aria-label="Découvrir le Cabinet des Curiosités">
      <span>Découvrir</span>
      <i aria-hidden="true"></i>
    </a>
  </section>

  <nav class="home-quicknav" aria-label="Explorer la page d'accueil">
    <span>Explorer le Cabinet</span>
    <div>
      <a href="#nouveautes">Nouveautés</a>
      <a href="#univers">Les univers</a>
      <a href="#stephanie">Le regard</a>
      <a href="#soin">Le soin</a>
    </div>
  </nav>

  <!-- MANIFESTE EN GRAND FORMAT -->
  <section class="home-manifesto" id="manifeste">
    <div class="home-manifesto__image reveal">
      <img src="/assets/still-2.jpg" alt="Détails d'une sélection d'objets chinés" />
    </div>
    <div class="home-manifesto__copy reveal">
      <span class="eyebrow">Le regard juste</span>
      <h2>Déjà vécus.<br />Prêts à vivre encore.</h2>
      <p>Céramiques, verreries, luminaires et curiosités sont choisis un à un. Pas de collection figée : seulement de belles matières, des traces du temps et des objets qui donnent une âme à la maison.</p>
      <a href="/a-propos" class="tlink">Découvrir notre histoire</a>
      <img class="home-manifesto__sprig" src="/assets/il-sprig.png" alt="" />
      <span class="home-manifesto__index">CDC — Lyon, France</span>
    </div>
  </section>

  <!-- TROUVAILLES GRAND FORMAT -->
  <section class="home-finds" id="nouveautes">
    <div class="wrap">
      <div class="home-finds__head reveal">
        <div>
          <span class="eyebrow">Fraîchement chinées</span>
          <h2>Les pièces du moment</h2>
        </div>
        <div class="home-finds__intro">
          <img src="/assets/il-sprig.png" alt="" />
          <p>Une sélection courte, vivante et toujours renouvelée.</p>
        </div>
      </div>
      <div class="home-finds__grid">
        {produits.map((p, i) => (
          <a href={`/trouvailles/${p.slug}`} class={`home-find home-find--${i + 1} reveal`}>
            <div class="home-find__media">
              <img src={cover(p)} alt={p.data.titre} />
              <span class={`home-find__badge${p.data.statut === "Réservé" ? " home-find__badge--reserved" : ""}`}>{p.data.statut}</span>
            </div>
            <div class="home-find__meta">
              <span>{String(i + 1).padStart(2, "0")} · {p.data.categorie}</span>
              <h3>{p.data.titre}</h3>
              <strong>{p.data.prix}&nbsp;€</strong>
            </div>
          </a>
        ))}
      </div>
      <div class="home-finds__all reveal"><a href="/trouvailles" class="btn">Voir toute la collection</a></div>
    </div>
  </section>

  <!-- CATÉGORIES LARGES -->
  <section class="home-categories" id="univers">
    <div class="wrap">
      <div class="home-categories__head reveal">
        <span class="eyebrow">Explorer</span>
        <h2>Une maison pleine de caractère.</h2>
      </div>
    </div>
    <div class="home-categories__grid reveal">
      {cats.map((c) => (
        <a class="home-category" href="/trouvailles">
          <img src={`/assets/${c.img}`} alt={c.l} loading="lazy" />
          <span class="home-category__label"><span>{c.l}</span><em>Découvrir</em></span>
        </a>
      ))}
    </div>
  </section>

  <!-- PORTRAIT -->
  <section class="home-founder" id="stephanie">
    <div class="home-founder__portrait reveal">
      <img src="/assets/fondatrice-3.jpg" alt="Stéphanie, fondatrice du Cabinet des Curiosités" />
    </div>
    <div class="home-founder__story reveal">
      <span class="home-founder__monogram" aria-hidden="true">C<em>D</em>C</span>
      <span class="eyebrow">Le regard de Stéphanie</span>
      <h2>Reconnaître la pièce<br />qui a quelque chose à dire.</h2>
      <p>Depuis près de quarante ans, Stéphanie regarde, touche et compare. Elle choisit des objets du XXᵉ siècle — souvent entre 1900 et 1980 — pour une courbe, une matière, une patine ou ce détail que l’on ne retrouve plus.</p>
      <blockquote>« Je ne cherche pas l’objet parfait. Je cherche celui qui donne immédiatement envie de lui faire une place. »</blockquote>
      <a href="/a-propos" class="tlink">Rencontrer Stéphanie</a>
    </div>
  </section>

  <!-- REGARD & HISTOIRE -->
  <section class="home-eye" aria-labelledby="home-eye-title">
    <div class="home-eye__copy reveal">
      <span class="eyebrow">Quarante ans à chiner</span>
      <h2 id="home-eye-title">Une mémoire des formes,<br />des matières et des époques.</h2>
      <p class="home-eye__lead">Au fil des années, l’œil apprend à reconnaître ce qui résistera au temps : un grès bien tourné, un verre soufflé irrégulier, une menuiserie solide, une couleur devenue plus belle avec l’âge.</p>
      <p>Le Cabinet réunit surtout des pièces françaises et européennes du XXᵉ siècle. Elles ne sont pas choisies pour suivre une tendance, mais pour leur capacité à dialoguer avec une maison d’aujourd’hui.</p>
      <a href="/a-propos" class="btn btn--light">Lire son histoire</a>
    </div>
    <div class="home-eye__visual reveal">
      <img src="/assets/still-1.jpg" alt="Objets anciens choisis pour leurs matières et leur patine" />
      <div class="home-eye__ledger" aria-label="Repères du Cabinet">
        <div><strong>40</strong><span>ans de chine<br />et de curiosité</span></div>
        <div><strong>1900—1980</strong><span>le cœur de<br />la sélection</span></div>
        <div><strong>1 par 1</strong><span>chaque pièce<br />est regardée</span></div>
      </div>
    </div>
  </section>

  <!-- SOIN DE LA COMMANDE -->
  <section class="home-care" id="soin">
    <div class="home-care__still reveal">
      <img src="/assets/packaging-stephanie.jpg" alt="Stéphanie enveloppant avec soin une céramique ancienne" />
      <span class="home-care__caption">Préparé à Lyon · avec attention</span>
    </div>
    <div class="home-care__copy reveal">
      <span class="eyebrow">Le soin jusqu’au dernier pli</span>
      <h2>Recevoir un objet<br />doit déjà être une émotion.</h2>
      <p>Nettoyée avec douceur, contrôlée une dernière fois, puis enveloppée avec précision : chaque pièce est préparée par Stéphanie. Les protections sont adaptées à sa matière, son poids et sa fragilité.</p>
      <div class="home-care__steps">
        <div><span>01</span><strong>Contrôlé</strong><small>État et détails vérifiés</small></div>
        <div><span>02</span><strong>Protégé</strong><small>Emballage sur mesure</small></div>
        <div><span>03</span><strong>Présenté</strong><small>Une attention dans chaque colis</small></div>
      </div>
      <a href="/contact" class="tlink">Une question sur la livraison ?</a>
    </div>
  </section>

  <section class="home-promise">
    <div class="wrap home-promise__inner reveal">
      <span class="eyebrow">La promesse du Cabinet</span>
      <h2>Choisi avec l’œil.<br />Transmis avec soin.</h2>
      <div class="home-promise__items">
        <span>01 · Pièces uniques</span>
        <span>02 · Description sincère</span>
        <span>03 · Envoi préparé à la main</span>
      </div>
    </div>
  </section>

</Layout>
