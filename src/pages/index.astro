---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

import { varier } from '../utils/varier';

const produits = varier(
  (await getCollection("produits"))
    .filter((p) => p.data.statut !== "Vendu")
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 10)
).slice(0, 6);
const cover = (p) => p.data.photos[0] ?? "/assets/placeholder.svg";
---
<Layout title="Cabinet des Curiosités — L'objet rare mérite un regard juste" active="home">

  <!-- HERO — BANNIÈRE ÉDITORIALE -->
  <section class="home-hero">
    <div class="home-hero__image">
      <img class="home-hero__fallback" src="/assets/hero-tiroir-curiosites.webp" alt="Des mains ouvrent un tiroir ancien garni de petits objets de collection" fetchpriority="high" />
    </div>
    <div class="home-hero__veil"></div>
    <div class="home-hero__content reveal">
      <span class="eyebrow">Objets chinés · Sélection singulière · Lyon</span>
      <h1>Des trésors qui ont une histoire à raconter.</h1>
      <p>Chaque curiosité est retenue pour sa ligne, sa matière, sa patine — et l’émotion qu’elle provoque.</p>
      <div class="home-hero__actions">
        <a href="/trouvailles" class="btn btn--light">Voir les trouvailles</a>
        <a href="#manifeste" class="home-hero__link">Découvrir le Cabinet</a>
      </div>
    </div>
    <aside class="home-hero__card reveal" aria-label="L’esprit de la sélection">
      <span>La sélection du Cabinet</span>
      <strong>Mes objets rares<br />& coups de cœur</strong>
      <small>Choisis par Stéfani</small>
    </aside>
    <a href="#manifeste" class="home-hero__scroll" aria-label="Découvrir la suite de la page"><span></span>Défiler</a>
  </section>

  <nav class="home-quicknav" aria-label="Explorer la page d'accueil">
    <span>Explorer le Cabinet</span>
    <div>
      <a href="#nouveautes">Nouveautés</a>
      <a href="#heritage">Le geste</a>
      <a href="#services">Mes services</a>
      <a href="#promesse">La promesse</a>
    </div>
  </nav>

  <!-- INTRODUCTION DE MARQUE -->
  <section class="home-intro" id="manifeste">
    <div class="home-intro__media reveal photo-reveal">
      <img src="/assets/selection-mains-assiette.webp" alt="Les mains de Stéfani présentent une assiette fleurie devant un buffet en bois clair garni de carafes roses, d’un réveil et d’un bouquet séché" />
      <span class="home-intro__caption">Chez soi · autrement</span>
    </div>
    <figure class="home-intro__detail reveal">
      <img src="/assets/selection-objets-detail.webp" alt="Lorgnon, réveil, verre ambré et petits objets anciens sur un meuble en bois clair" />
    </figure>
    <div class="home-intro__panel reveal">
      <div class="home-intro__copy">
        <span class="eyebrow">Une sélection très personnelle</span>
        <h2>Des pièces qui donnent envie<br /><em>de vivre avec elles.</em></h2>
        <p>Une ligne, une matière, une patine. Et parfois cette présence rare qui transforme un objet en évidence.</p>
        <a href="/a-propos" class="tlink">Découvrir mon histoire</a>
      </div>
      <div class="home-intro__facts" aria-label="Repères de la collection">
        <span>Années 1920 · 1950 · 1970</span><span>Pièces uniques</span><span>Choisies à Lyon</span>
      </div>
    </div>
  </section>

  <!-- TROUVAILLES GRAND FORMAT -->
  <section class="home-finds" id="nouveautes">
    <div class="wrap">
      <div class="home-finds__head reveal">
        <div>
          <span class="eyebrow">Fraîchement chinées</span>
          <h2>La sélection du moment</h2>
        </div>
        <div class="home-finds__intro">
          <p>Quelques pièces choisies récemment.<br />Elles sont là aujourd’hui — demain, peut-être plus.</p>
          <a href="/trouvailles" class="home-finds__headlink">Voir toute la collection <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="home-finds__grid">
        {produits.map((p, i) => (
          <a href={`/trouvailles/${p.slug}`} class={`home-find home-find--${i + 1} reveal`}>
            <div class="home-find__media">
              <img src={cover(p)} alt={p.data.titre} />
              <span class={`home-find__badge${p.data.statut === "Réservé" ? " home-find__badge--reserved" : ""}`}>{p.data.statut}</span>
            </div>
            <div class="home-find__meta">
              <span>{String(i + 1).padStart(2, "0")} · {p.data.categorie}</span>
              <h3>{p.data.titre}</h3>
              <strong>{p.data.prix}&nbsp;€</strong>
            </div>
          </a>
        ))}
      </div>
      <div class="home-finds__all reveal"><a href="/trouvailles" class="btn">Voir toute la collection</a></div>
    </div>
  </section>

  <!-- L'ENFANCE — souvenir intime -->
  <section class="home-memoir" id="heritage" aria-labelledby="memoir-title">
    <div class="wrap home-memoir__editorial">
      <div class="home-memoir__scene reveal photo-reveal">
      <img class="home-memoir__home" src="/assets/stefani-photo-enfance.webp" alt="Stéfani, vue de dos, tient une photographie d’enfance au-dessus d’une boîte de souvenirs anciens" loading="lazy" />
        <span class="home-memoir__note">De la curiosité à la collection</span>
      </div>
      <div class="home-memoir__story reveal">
        <span class="eyebrow">Une passion depuis l’enfance</span>
        <h2 id="memoir-title">Les objets racontaient déjà <em>des histoires.</em></h2>
        <p>Enfant, je suivais ma maman parmi les stands, les boîtes et les tiroirs. À ses côtés, j’ai appris à regarder au-delà de la poussière : une matière, une forme ou une patine pouvait déjà contenir toute une vie.</p>
        <p>Ce regard ne m’a jamais quittée. Chaque pièce choisie aujourd’hui garde un peu de cette curiosité et l’envie très simple de faire durer les belles histoires.</p>
        <div class="home-memoir__footer">
          <a href="/a-propos" class="tlink">Découvrir mon histoire</a>
          <figure class="home-memoir__keepsake" aria-label="Photo d’enfance de Stéfani">
            <img src="/assets/stefani-enfant-archive-v1.webp" alt="Stéfani enfant, coiffée d’un bonnet rayé" loading="lazy" />
            <figcaption>Stéfani · petite chineuse</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="home-promise" id="promesse">
    <div class="wrap home-promise__inner reveal">
      <span class="eyebrow">La promesse du Cabinet</span>
      <h2>Chaque trouvaille arrive prête<br />à poursuivre son histoire.</h2>
      <div class="home-promise__items">
        <span>01 · Curiosités &amp; pièces d’exception</span>
        <span>02 · Description sincère</span>
        <span>03 · Envoi préparé à la main</span>
      </div>
    </div>
  </section>

  <!-- SOIN DE LA COMMANDE -->
  <section class="home-care" id="soin">
    <div class="home-care__copy reveal">
      <span class="eyebrow">Le soin jusqu’au dernier pli</span>
      <h2>L’émotion commence<br />dès l’ouverture du colis.</h2>
      <p>Chaque objet est nettoyé avec douceur, contrôlé une dernière fois, puis enveloppé avec précision. Les protections s’adaptent à sa matière, son poids et sa fragilité.</p>
      <div class="home-care__steps">
        <div><span>01</span><strong>Contrôlé</strong><small>État et détails vérifiés</small></div>
        <div><span>02</span><strong>Protégé</strong><small>Emballage sur mesure</small></div>
        <div><span>03</span><strong>Présenté</strong><small>Une attention dans chaque colis</small></div>
      </div>
      <a href="/contact" class="tlink">Une question sur la livraison ?</a>
    </div>
    <div class="home-care__still reveal photo-reveal">
      <img src="/assets/emballage-assiette-fleurie.webp" alt="Stéfani noue un ruban autour d’une assiette fleurie soigneusement emballée dans du papier de soie" loading="lazy" />
      <span class="home-care__caption">Préparé à Lyon · avec attention</span>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="home-svc" id="services">
    <div class="wrap">
      <div class="home-svc__head reveal">
        <span class="eyebrow">Au-delà de la boutique</span>
        <h2>Quatre façons de faire vivre<br />les objets anciens.</h2>
        <p>Les chercher pour vous, les remettre en beauté, les vendre à votre place ou venir les sauver d’un grenier.</p>
      </div>
      <div class="home-svc__grid reveal">
        <a class="home-svc__item" href="/services#chiner"><span>01</span><h3>Personal Chineur</h3><p>Je pars chercher la pépite dont vous rêvez.</p></a>
        <a class="home-svc__item" href="/services#atelier"><span>02</span><h3>Atelier rénovation</h3><p>On bichonne ensemble ce qui vous tient à cœur.</p></a>
        <a class="home-svc__item" href="/services#depot"><span>03</span><h3>Dépôt-vente</h3><p>Je mets en valeur et je vends vos objets.</p></a>
        <a class="home-svc__item" href="/services#vide-maison"><span>04</span><h3>Vide-maison</h3><p>Débarras de la cave au grenier, tous volumes.</p></a>
      </div>
      <div class="home-svc__all reveal"><a href="/services" class="btn">Découvrir mes services</a></div>
    </div>
  </section>

  <!-- PERSONAL CHINEUR — invitation finale -->
  <section class="home-chineur" id="personal-chineur" aria-labelledby="chineur-title">
    <figure class="home-chineur__image reveal photo-reveal">
      <img src="/assets/personal-chineur-pentes-v2.webp" alt="Brocante sur les pentes pavées de la Croix-Rousse à Lyon" loading="lazy" />
      <figcaption>Les Pentes · Croix-Rousse</figcaption>
    </figure>
    <div class="home-chineur__copy reveal">
      <span class="eyebrow">Personal Chineur</span>
      <h2 id="chineur-title">Vous l’imaginez déjà chez vous. <em>Je pars le chiner.</em></h2>
      <p>Chiner… mon passe-temps favori, sans l’ombre d’un doute. Si un objet précis vous trotte dans la tête mais que le temps ou les occasions manquent, racontez-le-moi&nbsp;: je pars en quête pour vous.</p>
    </div>
    <div class="home-chineur__contact reveal" aria-label="Contacter Stéfani pour une recherche personnalisée">
      <a class="home-chineur__cta" href="https://wa.me/33625371757?text=Bonjour%20St%C3%A9fani%2C%20je%20souhaite%20vous%20confier%20la%20recherche%20d%27un%20objet.">Me confier une recherche <span aria-hidden="true">↗</span></a>
      <span>Ou échanger directement</span>
      <a href="tel:+33625371757">06 25 37 17 57</a>
      <a href="mailto:contact@brocaddict.fr">contact@brocaddict.fr</a>
    </div>
  </section>

</Layout>
