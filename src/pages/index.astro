---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const produits = (await getCollection("produits"))
  .filter((p) => p.data.statut !== "Vendu")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
const cover = (p) => p.data.photos[0] ?? "/assets/placeholder.svg";
---
<Layout title="Cabinet des Curiosités — L'objet rare mérite un regard juste" active="home">

  <!-- HERO — BANNIÈRE ÉDITORIALE -->
  <section class="home-hero">
    <div class="home-hero__image">
      <img class="home-hero__fallback" src="/assets/hero-tiroir-lumineux-v6.jpg" alt="Les mains tatouées de Stéfani ouvrant un tiroir ancien rempli de trésors des années 1920 à 1970" fetchpriority="high" />
    </div>
    <div class="home-hero__veil"></div>
    <div class="home-hero__content reveal">
      <span class="eyebrow">Objets chinés · Sélection singulière · Lyon</span>
      <h1>Des trésors qui ont une histoire à raconter.</h1>
      <p>Chaque curiosité est retenue pour sa ligne, sa matière, sa patine — et l’émotion qu’elle provoque.</p>
      <div class="home-hero__actions">
        <a href="/trouvailles" class="btn btn--light">Voir les trouvailles</a>
        <a href="#manifeste" class="home-hero__link">Découvrir le Cabinet</a>
      </div>
    </div>
    <aside class="home-hero__card reveal" aria-label="L’esprit de la sélection">
      <span>La sélection du Cabinet</span>
      <strong>Mes objets rares<br />& coups de cœur</strong>
      <small>Choisis par Stéfani</small>
    </aside>
    <a href="#manifeste" class="home-hero__scroll" aria-label="Découvrir la suite de la page"><span></span>Défiler</a>
  </section>

  <nav class="home-quicknav" aria-label="Explorer la page d'accueil">
    <span>Explorer le Cabinet</span>
    <div>
      <a href="#nouveautes">Nouveautés</a>
      <a href="#heritage">Le geste</a>
      <a href="#services">Les services</a>
    </div>
  </nav>

  <!-- INTRODUCTION DE MARQUE -->
  <section class="home-intro" id="manifeste">
    <div class="home-intro__media reveal photo-reveal">
      <img src="/assets/intro-stefani-maison-v9.webp" alt="Stéfani installant des objets anciens dans une maison lumineuse et chaleureuse" />
      <span class="home-intro__caption">Chez soi · autrement</span>
    </div>
    <figure class="home-intro__detail reveal">
      <img src="/assets/interieur-dame-jeanne-v2.webp" alt="Table basse vintage et lampe Dame-Jeanne dans un intérieur chaleureux" />
    </figure>
    <div class="home-intro__panel reveal">
      <div class="home-intro__copy">
        <span class="eyebrow">Une sélection très personnelle</span>
        <h2>Des merveilles qui donnent envie<br /><em>de vivre avec elles.</em></h2>
        <p>Une ligne, une matière, une patine. Et parfois cette présence rare qui transforme un objet en évidence.</p>
        <a href="/a-propos" class="tlink">Découvrir mon histoire</a>
      </div>
      <div class="home-intro__facts" aria-label="Repères de la collection">
        <span>Années 1920 · 1950 · 1970</span><span>Pièces uniques</span><span>Choisies à Lyon</span>
      </div>
    </div>
  </section>

  <!-- TROUVAILLES GRAND FORMAT -->
  <section class="home-finds" id="nouveautes">
    <div class="wrap">
      <div class="home-finds__head reveal">
        <div>
          <span class="eyebrow">Fraîchement chinées</span>
          <h2>Mes pépites du moment</h2>
        </div>
        <div class="home-finds__intro">
          <p>Voici six trouvailles qui m’ont arrêtée dernièrement.<br />Elles sont là aujourd’hui — demain, peut-être plus.</p>
        </div>
      </div>
      <div class="home-finds__grid">
        {produits.map((p, i) => (
          <a href={`/trouvailles/${p.slug}`} class={`home-find home-find--${i + 1} reveal`}>
            <div class="home-find__media">
              <img src={cover(p)} alt={p.data.titre} />
              <span class={`home-find__badge${p.data.statut === "Réservé" ? " home-find__badge--reserved" : ""}`}>{p.data.statut}</span>
            </div>
            <div class="home-find__meta">
              <span>{String(i + 1).padStart(2, "0")} · {p.data.categorie}</span>
              <h3>{p.data.titre}</h3>
              <strong>{p.data.prix}&nbsp;€</strong>
            </div>
          </a>
        ))}
      </div>
      <div class="home-finds__all reveal"><a href="/trouvailles" class="btn">Voir toute la collection</a></div>
    </div>
  </section>

  <!-- L'ENFANCE — souvenir intime -->
  <section class="home-memoir" aria-labelledby="memoir-title">
    <div class="wrap home-memoir__inner">
      <figure class="home-memoir__photo reveal photo-reveal">
        <img src="/assets/stefani-enfant-archive-v1.webp" alt="Stéfani, enfant" loading="lazy" />
        <figcaption>Stéfani · une curiosité déjà bien éveillée</figcaption>
      </figure>
      <div class="home-memoir__txt reveal">
        <span class="eyebrow">Une passion transmise</span>
        <h2 id="memoir-title">Petite, je chinais déjà<br /><em>aux côtés de ma grand-mère.</em></h2>
        <p>Je l’accompagnais parmi les stands, les boîtes et les tiroirs. Elle m’a appris à regarder au-delà de la poussière : une matière, une forme ou une patine pouvait déjà contenir toute une histoire.</p>
        <p>Cette curiosité ne m’a jamais quittée. Chaque merveille choisie aujourd’hui porte un peu de ce regard d’enfant — et l’envie de lui offrir une nouvelle maison.</p>
        <span class="home-memoir__sign" aria-hidden="true">Stéfani</span>
      </div>
    </div>
  </section>

  <!-- SOIN DE LA COMMANDE -->
  <section class="home-care" id="soin">
    <div class="home-care__still reveal photo-reveal">
      <img src="/assets/soin-colis-cygne-v4.webp" alt="Une curiosité en laiton soigneusement enveloppée dans du papier de soie et nouée d’un ruban" />
      <span class="home-care__caption">Préparé à Lyon · avec attention</span>
    </div>
    <div class="home-care__copy reveal">
      <span class="eyebrow">Le soin jusqu’au dernier pli</span>
      <h2>L’émotion commence<br />dès l’ouverture du colis.</h2>
      <p>Chaque trésor est nettoyé avec douceur, contrôlé une dernière fois, puis enveloppé avec précision. Les protections s’adaptent à sa matière, son poids et sa fragilité.</p>
      <div class="home-care__steps">
        <div><span>01</span><strong>Contrôlé</strong><small>État et détails vérifiés</small></div>
        <div><span>02</span><strong>Protégé</strong><small>Emballage sur mesure</small></div>
        <div><span>03</span><strong>Présenté</strong><small>Une attention dans chaque colis</small></div>
      </div>
      <a href="/contact" class="tlink">Une question sur la livraison ?</a>
    </div>
  </section>

  <!-- PERSONAL CHINEUR — la recherche sur demande -->
  <section class="home-resale" id="recherche" aria-labelledby="resale-title">
    <div class="home-resale__image">
      <img src="/assets/transmission-objet-stefani.webp" alt="Une pépite ancienne confiée délicatement de main en main" loading="lazy" />
    </div>
    <div class="home-resale__veil"></div>
    <div class="wrap home-resale__inner">
      <div class="home-resale__card reveal">
        <span class="eyebrow">Votre Personal Chineur</span>
        <h2 id="resale-title">La pépite dont vous rêvez ?<br />Je pars la chiner pour vous.</h2>
        <p>Chiner… mon passe-temps favori, sans l’ombre d’un doute. Si un trésor vous fait envie depuis longtemps — par manque de temps ou de piste — décrivez-le-moi : je me languis de découvrir les merveilles que vous convoitez, et je garde l’œil ouvert jusqu’à la dénicher.</p>
        <a href="tel:0625371757" class="btn btn--solid">06 25 37 17 57 — parlons-en</a>
        <a href="mailto:contact@brocaddict.fr" class="home-resale__mail">ou par écrit : contact@brocaddict.fr</a>
        <small>Une description · une photo d’inspiration · votre plus belle envie</small>
      </div>
    </div>
  </section>

  <section class="home-promise">
    <div class="wrap home-promise__inner reveal">
      <span class="eyebrow">La promesse du Cabinet</span>
      <h2>Chaque trouvaille arrive prête<br />à poursuivre son histoire.</h2>
      <div class="home-promise__items">
        <span>01 · Curiosités &amp; pièces d’exception</span>
        <span>02 · Description sincère</span>
        <span>03 · Envoi préparé à la main</span>
      </div>
    </div>
  </section>

</Layout>
