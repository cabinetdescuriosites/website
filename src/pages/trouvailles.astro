---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const filters = [
  { k: "all", l: "Tout" }, { k: "nouveautes", l: "Nouveautés" }, { k: "arts-table", l: "Arts de la table" },
  { k: "luminaires", l: "Luminaires" }, { k: "petit-mobilier", l: "Petit mobilier" },
  { k: "decoration", l: "Décoration" }, { k: "curiosites", l: "Curiosités" }, { k: "exception", l: "Pièces d’exception" },
];
const catKey = { "Arts de la table": "arts-table", "Luminaires": "luminaires", "Petit mobilier": "petit-mobilier", "Décoration": "decoration", "Curiosités": "curiosites", "Pièces d’exception": "exception" };
const badgeMod = { "Réservé": "r", "Vendu": "v" };

const produits = (await getCollection("produits"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const cover = (p) => p.data.photos[0] ?? "/assets/placeholder.svg";
---
<Layout title="Les Trouvailles — Cabinet des Curiosités" active="trouvailles" inner={true}>
  <section class="catalog-intro">
    <div class="wrap catalog-intro__inner">
      <div class="catalog-intro__top">
        <span class="eyebrow">Ma sélection actuelle</span>
        <small>{produits.length.toString().padStart(2, "0")} trouvailles en ligne</small>
      </div>
      <div class="catalog-intro__title">
        <h1>Les Trouvailles</h1>
        <p>Voici mes trouvailles, choisies une à une. Chacune s’est imposée par une ligne, une matière, une patine — ou par cette émotion immédiate qui ne demande aucune explication.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:clamp(56px,7vw,96px)">
    <div class="wrap">
      <div class="filters" aria-label="Filtrer les trouvailles">
        {filters.map((f, i) => (
          <button data-filter={f.k} class={i === 0 ? "on" : undefined} aria-pressed={i === 0 ? "true" : "false"}>{f.l}</button>
        ))}
      </div>
      <div class="shop">
        {produits.map((p, i) => (
          <a href={`/trouvailles/${p.slug}`} class="pcard reveal" data-cat={catKey[p.data.categorie]} data-new={i < 6 ? "true" : undefined}>
            <div class="pcard__media">
              <span class="pcard__idx">{String(i + 1).padStart(2, "0")}</span>
              <span class={`pcard__badge${badgeMod[p.data.statut] ? ` pcard__badge--${badgeMod[p.data.statut]}` : ""}`}>{p.data.statut}</span>
              <img class="pcard__primary" src={cover(p)} alt={p.data.titre} loading="lazy" />
            </div>
            <div class="pcard__body">
              <div><div class="pcard__name">{p.data.titre}</div><div class="pcard__cat">{p.data.categorie}</div></div>
              <div class={`pcard__price${p.data.statut === "Vendu" ? " sold" : ""}`}>{p.data.prix}&nbsp;€</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="collection-note">
    <div class="wrap collection-note__inner">
      <figure class="collection-note__media reveal">
        <img src="/assets/transmission-objet-stefani.webp" alt="Des mains confient délicatement un objet ancien en laiton" loading="lazy" />
        <figcaption>Une nouvelle histoire pour chaque pépite</figcaption>
      </figure>
      <div class="collection-note__copy reveal">
        <span class="eyebrow">Votre Personal Chineur</span>
        <h2>La merveille que vous cherchez<br />n’est pas encore ici ?</h2>
        <p>Décrivez-moi la pépite que vous avez en tête — une photo d’inspiration suffit. Je pars la chiner pour vous et je vous préviens dès qu’une trouvaille lui ressemble.</p>
        <a href="https://wa.me/33625371757?text=Bonjour%20St%C3%A9fani%2C%20j%27aimerais%20vous%20confier%20la%20recherche%20d%27un%20objet." class="btn btn--solid" target="_blank" rel="noopener noreferrer">Confier une recherche</a>
        <small style="display:block;margin-top:14px"><a href="tel:0625371757">06 25 37 17 57</a> · <a href="mailto:contact@brocaddict.fr">contact@brocaddict.fr</a></small>
      </div>
    </div>
  </section>
</Layout>
