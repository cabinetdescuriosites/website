---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const filters = [
  { k: "all", l: "Tout" }, { k: "ceramique", l: "Céramique" }, { k: "verrerie", l: "Verrerie" },
  { k: "mobilier", l: "Mobilier" }, { k: "luminaire", l: "Luminaires" }, { k: "curiosite", l: "Curiosités" },
];
const catKey = { "Céramique": "ceramique", "Verrerie": "verrerie", "Mobilier": "mobilier", "Luminaire": "luminaire", "Curiosité": "curiosite" };
const badgeMod = { "Réservé": "r", "Vendu": "v" };

const produits = (await getCollection("produits"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="Les Trouvailles — Cabinet des Curiosités" active="trouvailles" inner={true}>
  <section class="pagehero">
    <div class="pagehero__bg"><img src="/assets/still-1.jpg" alt="" /></div>
    <div class="pagehero__in">
      <span class="eyebrow">La collection</span>
      <h1>Les Trouvailles</h1>
      <p>Des pièces uniques, chinées une à une. Lorsqu'un objet est parti, il l'est pour de bon.</p>
    </div>
  </section>

  <section class="section" style="padding-top:clamp(56px,7vw,96px)">
    <div class="wrap">
      <div class="filters">
        {filters.map((f, i) => (
          <button data-filter={f.k} class={i === 0 ? "on" : undefined}>{f.l}</button>
        ))}
      </div>
      <div class="shop">
        {produits.map((p, i) => (
          <a href={`/trouvailles/${p.slug}`} class="pcard reveal" data-cat={catKey[p.data.categorie]}>
            <div class="pcard__media">
              <span class="pcard__idx">{String(i + 1).padStart(2, "0")}</span>
              <span class={`pcard__badge${badgeMod[p.data.statut] ? ` pcard__badge--${badgeMod[p.data.statut]}` : ""}`}>{p.data.statut}</span>
              <img src={p.data.photos[0]} alt={p.data.titre} loading="lazy" />
            </div>
            <div class="pcard__name">{p.data.titre}</div>
            <div class="pcard__cat">{p.data.categorie}</div>
            <div class={`pcard__price${p.data.statut === "Vendu" ? " sold" : ""}`}>{p.data.prix}&nbsp;€</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
