---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const filters = [
  { k: "all", l: "Tout" }, { k: "ceramique", l: "Céramique" }, { k: "verrerie", l: "Verrerie" },
  { k: "mobilier", l: "Mobilier" }, { k: "luminaire", l: "Luminaires" }, { k: "curiosite", l: "Curiosités" },
];
const catKey = { "Céramique": "ceramique", "Verrerie": "verrerie", "Mobilier": "mobilier", "Luminaire": "luminaire", "Curiosité": "curiosite" };
const badgeMod = { "Réservé": "r", "Vendu": "v" };

const produits = (await getCollection("produits"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const cover = (p) => p.data.photos[0] ?? "/assets/placeholder.svg";
const secondPhoto = (p) => p.data.photos[1];
---
<Layout title="Les Trouvailles — Cabinet des Curiosités" active="trouvailles" inner={true}>
  <section class="catalog-intro">
    <div class="wrap catalog-intro__inner">
      <div class="catalog-intro__top">
        <span class="eyebrow">Ma sélection actuelle</span>
        <small>{produits.length.toString().padStart(2, "0")} pièces en ligne</small>
      </div>
      <div class="catalog-intro__title">
        <h1>Les Trouvailles</h1>
        <p>Voici les pièces que j’ai choisies, une à une. Chacune m’a arrêtée pour une ligne, une matière, une patine — ou pour cette émotion que je ne cherche jamais à expliquer.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:clamp(56px,7vw,96px)">
    <div class="wrap">
      <div class="filters" aria-label="Filtrer les trouvailles">
        {filters.map((f, i) => (
          <button data-filter={f.k} class={i === 0 ? "on" : undefined} aria-pressed={i === 0 ? "true" : "false"}>{f.l}</button>
        ))}
      </div>
      <div class="shop">
        {produits.map((p, i) => (
          <a href={`/trouvailles/${p.slug}`} class="pcard reveal" data-cat={catKey[p.data.categorie]}>
            <div class="pcard__media">
              <span class="pcard__idx">{String(i + 1).padStart(2, "0")}</span>
              <span class={`pcard__badge${badgeMod[p.data.statut] ? ` pcard__badge--${badgeMod[p.data.statut]}` : ""}`}>{p.data.statut}</span>
              <img class="pcard__primary" src={cover(p)} alt={p.data.titre} loading="lazy" />
              {secondPhoto(p) && <img class="pcard__secondary" src={secondPhoto(p)} alt="" loading="lazy" />}
              <span class="pcard__view">Voir la pièce <i>↗</i></span>
            </div>
            <div class="pcard__body">
              <div><div class="pcard__name">{p.data.titre}</div><div class="pcard__cat">{p.data.categorie}</div></div>
              <div class={`pcard__price${p.data.statut === "Vendu" ? " sold" : ""}`}>{p.data.prix}&nbsp;€</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="collection-note">
    <div class="wrap collection-note__inner">
      <figure class="collection-note__media reveal">
        <img src="/assets/transmission-objet-stefani.webp" alt="Des mains confient délicatement un objet ancien en laiton" loading="lazy" />
        <figcaption>Une nouvelle histoire pour chaque objet</figcaption>
      </figure>
      <div class="collection-note__copy reveal">
        <span class="eyebrow">Vous souhaitez vendre un objet ?</span>
        <h2>Confiez-moi la pièce<br />que vous souhaitez transmettre.</h2>
        <p>Envoyez-moi quelques photos, ses dimensions et ce que vous connaissez de son histoire. Je vous répondrai directement.</p>
        <a href="https://wa.me/33625371757?text=Bonjour%20St%C3%A9fani%2C%20je%20souhaite%20vous%20proposer%20un%20objet%20%C3%A0%20la%20vente." class="btn btn--solid" target="_blank" rel="noopener noreferrer">Écrire sur WhatsApp</a>
      </div>
    </div>
  </section>
</Layout>
