---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const produits = await getCollection("produits");
  return produits.map((p) => ({ params: { slug: p.slug }, props: { produit: p, all: produits } }));
}

const { produit, all } = Astro.props;
const { Content } = await produit.render();
const d = produit.data;
const badgeMod = { "Réservé": "r", "Vendu": "v" };
const PLACEHOLDER = "/assets/placeholder.svg";
const photos = d.photos.length ? d.photos : [PLACEHOLDER];
const cover = (p) => p.data.photos[0] ?? PLACEHOLDER;
const whatsappUrl = `https://wa.me/33625371757?text=${encodeURIComponent(`Bonjour Stéfani, je souhaiterais plus d’informations sur « ${d.titre} ».`)}`;

const similaires = all
  .filter((p) => p.slug !== produit.slug && p.data.statut !== "Vendu")
  .sort((a, b) => (b.data.categorie === d.categorie ? 1 : 0) - (a.data.categorie === d.categorie ? 1 : 0))
  .slice(0, 3);

const metaDescription = `${(produit.body ?? "").trim().replace(/\s+/g, " ").slice(0, 140)}${(produit.body ?? "").trim().length > 140 ? "…" : ""} ${d.categorie} · ${d.epoque ?? "pièce ancienne"} · ${d.prix} € · ${d.statut}.`.trim();
---
<Layout title={`${d.titre} — Cabinet des Curiosités`} description={metaDescription} image={photos[0]} active="trouvailles" inner={true}>
  <div class="wrap"><nav class="breadcrumb"><a href="/">Accueil</a> — <a href="/trouvailles">Les Trouvailles</a> — <span>{d.titre}</span></nav></div>

  <section class="product-page">
    <div class="wrap product-layout">
      <div class="product-gallery product-gallery--develop" data-product-gallery>
        <img class="product-gallery__main" src={photos[0]} alt={d.titre} data-product-main />
        <span class="product-gallery__cap">Pièce unique · choisie par moi</span>
        {photos.length > 1 && (
          <div class="pd-thumbs">
            {photos.map((ph, i) => (
              <button class={i === 0 ? "is-active" : undefined} data-product-thumb={ph} aria-label={`Voir la photo ${i + 1}`}>
                <img src={ph} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>
      <div class="product-info">
        <span class="eyebrow">{d.categorie} · {d.statut}</span>
        <h1>{d.titre}</h1>
        <div class={`pdprice${d.statut === "Vendu" ? " sold" : ""}`}>{d.prix}&nbsp;€</div>
        <div class="product-info__story"><Content /></div>
        <dl class="specs">
          {d.etat && <div><dt>État</dt><dd>{d.etat}</dd></div>}
          {d.dimensions && <div><dt>Dimensions</dt><dd>{d.dimensions}</dd></div>}
          {d.epoque && <div><dt>Époque</dt><dd>{d.epoque}</dd></div>}
          <div><dt>Livraison</dt><dd>{d.livraison}</dd></div>
        </dl>
        <div class="buybox">
          <a href={whatsappUrl} class="btn btn--solid" target="_blank" rel="noopener noreferrer">Plus d’informations sur WhatsApp</a>
          <small class="buybox__note">Une question, une photo de détail ou une vidéo ? Stéfani vous répond directement.</small>
          <div class="reassure"><span>Réponse personnelle</span><span>Pièce unique</span><span>Emballage soigné</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="product-care">
    <div class="wrap product-care__grid">
      <div class="product-care__title reveal">
        <span class="eyebrow">Le soin du Cabinet</span>
        <h2>Cette pièce sera préparée<br />comme si elle restait au Cabinet.</h2>
      </div>
      <div class="product-care__items reveal">
        <div><span>01</span><strong>Vérifiée</strong><p>L’état et les détails sont contrôlés une dernière fois.</p></div>
        <div><span>02</span><strong>Protégée</strong><p>L’emballage est adapté à sa matière et à sa fragilité.</p></div>
        <div><span>03</span><strong>Préparée à la main</strong><p>Chaque commande est mise en colis avec la même attention.</p></div>
      </div>
    </div>
  </section>

  {similaires.length > 0 && (
    <section class="section section--tint">
      <div class="wrap">
        <div class="grid-head"><span class="eyebrow">Dans le même esprit</span><h2>Produits similaires</h2></div>
        <div class="shop">
          {similaires.map((p) => (
            <a href={`/trouvailles/${p.slug}`} class="pcard reveal">
              <div class="pcard__media photo-reveal">
                <span class={`pcard__badge${badgeMod[p.data.statut] ? ` pcard__badge--${badgeMod[p.data.statut]}` : ""}`}>{p.data.statut}</span>
                <img class="pcard__primary" src={cover(p)} alt={p.data.titre} loading="lazy" />
                <span class="pcard__view">Voir la pièce <i>↗</i></span>
              </div>
              <div class="pcard__body"><div><div class="pcard__name">{p.data.titre}</div><div class="pcard__cat">{p.data.categorie}</div></div><div class="pcard__price">{p.data.prix}&nbsp;€</div></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
