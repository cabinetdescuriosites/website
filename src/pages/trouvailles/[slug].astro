---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const produits = await getCollection("produits");
  return produits.map((p) => ({ params: { slug: p.slug }, props: { produit: p, all: produits } }));
}

const { produit, all } = Astro.props;
const { Content } = await produit.render();
const d = produit.data;
const badgeMod = { "Réservé": "r", "Vendu": "v" };
const PLACEHOLDER = "/assets/placeholder.svg";
const photos = d.photos.length ? d.photos : [PLACEHOLDER];
const cover = (p) => p.data.photos[0] ?? PLACEHOLDER;

const similaires = all
  .filter((p) => p.slug !== produit.slug && p.data.statut !== "Vendu")
  .sort((a, b) => (b.data.categorie === d.categorie ? 1 : 0) - (a.data.categorie === d.categorie ? 1 : 0))
  .slice(0, 3);
---
<Layout title={`${d.titre} — Cabinet des Curiosités`} active="trouvailles" inner={true}>
  <div class="wrap"><nav class="breadcrumb"><a href="/">Accueil</a> — <a href="/trouvailles">Les Trouvailles</a> — <span>{d.titre}</span></nav></div>

  <section class="product-page">
    <div class="wrap product-layout">
      <div class="product-gallery">
        <img src={photos[0]} alt={d.titre} />
        <span class="product-gallery__cap">Pièce unique · sélectionnée par Stéphanie</span>
        {photos.length > 1 && (
          <div class="pd-thumbs">
            {photos.map((ph) => (<img src={ph} alt="" loading="lazy" />))}
          </div>
        )}
      </div>
      <div class="product-info">
        <span class="eyebrow">{d.categorie} · {d.statut}</span>
        <h1>{d.titre}</h1>
        <div class={`pdprice${d.statut === "Vendu" ? " sold" : ""}`}>{d.prix}&nbsp;€</div>
        <div class="product-info__story"><Content /></div>
        <dl class="specs">
          {d.etat && <div><dt>État</dt><dd>{d.etat}</dd></div>}
          {d.dimensions && <div><dt>Dimensions</dt><dd>{d.dimensions}</dd></div>}
          {d.epoque && <div><dt>Époque</dt><dd>{d.epoque}</dd></div>}
          <div><dt>Livraison</dt><dd>{d.livraison}</dd></div>
        </dl>
        <div class="buybox">
          {d.statut === "Disponible" && <a href="#" class="btn btn--solid" data-demo="Redirection vers le paiement sécurisé…">Acheter — paiement sécurisé</a>}
          {d.statut === "Réservé" && <span class="btn" style="pointer-events:none;opacity:.6">Pièce réservée</span>}
          {d.statut === "Vendu" && <span class="btn" style="pointer-events:none;opacity:.6">Pièce vendue</span>}
          <a href="/contact" class="btn">Réserver / poser une question</a>
          <div class="reassure"><span>✦ Paiement sécurisé</span><span>✦ Pièce unique</span><span>✦ Préparé par Stéphanie</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="product-care">
    <div class="wrap product-care__grid">
      <div class="product-care__title reveal">
        <span class="eyebrow">Le soin du Cabinet</span>
        <h2>Cette pièce voyagera<br />comme si elle était la nôtre.</h2>
      </div>
      <div class="product-care__items reveal">
        <div><span>01</span><strong>Vérifiée</strong><p>L’état et les détails sont contrôlés une dernière fois.</p></div>
        <div><span>02</span><strong>Protégée</strong><p>L’emballage est adapté à sa matière et à sa fragilité.</p></div>
        <div><span>03</span><strong>Préparée à la main</strong><p>Chaque commande est mise en colis par Stéphanie.</p></div>
      </div>
    </div>
  </section>

  {similaires.length > 0 && (
    <section class="section section--tint">
      <div class="wrap">
        <div class="grid-head"><span class="eyebrow">Dans le même esprit</span><h2>Produits similaires</h2></div>
        <div class="shop">
          {similaires.map((p) => (
            <a href={`/trouvailles/${p.slug}`} class="pcard reveal">
              <div class="pcard__media"><span class={`pcard__badge${badgeMod[p.data.statut] ? ` pcard__badge--${badgeMod[p.data.statut]}` : ""}`}>{p.data.statut}</span><img src={cover(p)} alt={p.data.titre} loading="lazy" /></div>
              <div class="pcard__name">{p.data.titre}</div><div class="pcard__cat">{p.data.categorie}</div><div class="pcard__price">{p.data.prix}&nbsp;€</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
