---
const { active = "" } = Astro.props;
const nav = [
  { href: "/", label: "Accueil", key: "home" },
  { href: "/trouvailles", label: "Les Trouvailles", key: "trouvailles" },
  { href: "/a-propos", label: "À propos", key: "apropos" },
  { href: "/contact", label: "Contact", key: "contact" },
];
---
<header class="site-header">
  <div class="hdr">
    <a href="/" class="hdr__brand">
      <span class="mono">C<em>D</em>C</span>
      <span class="n">Cabinet des Curiosités</span>
    </a>
    <nav class="hdr__nav" aria-label="Navigation">
      {nav.map((n) => (
        <a href={n.href} aria-current={active === n.key ? "page" : undefined}>{n.label}</a>
      ))}
      <a class="nav__ig" href="https://instagram.com/brocaddict.cafe" aria-label="Instagram">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
    </nav>
    <button class="hdr__toggle" aria-label="Ouvrir le menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <button class="hdr__backdrop" data-menu-close aria-label="Fermer le menu"></button>
  </div>
</header>
