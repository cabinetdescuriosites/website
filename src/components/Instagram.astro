---
// Les huit dernières publications de la grille @cabinet.curiosites.lyon (mises à jour à la main :
// déposer les carrés dans public/assets/insta/ et reporter ici le lien de chaque publication).
const compte = "https://www.instagram.com/cabinet.curiosites.lyon/";
const posts = [
  { img: "post-1.webp", lien: "p/CghhiDVrhWn" },
  { img: "post-2.webp", lien: "p/CYG9wbVIuhg" },
  { img: "post-3.webp", lien: "p/Cgj3HnpKU1W" },
  { img: "post-4.webp", lien: "p/CYW5d8WqO2E" },
  { img: "post-5.webp", lien: "reel/CqFQy9jrTbz" },
  { img: "post-6.webp", lien: "p/CpsWbTlID9e" },
  { img: "post-7.webp", lien: "p/Cgj_zs0IQA-" },
  { img: "post-8.webp", lien: "p/CYmxfnarMN2" },
];
---
<section class="insta">
  <div class="wrap">
    <div class="insta__h reveal">
      <span class="eyebrow">Sur Instagram</span>
      <a class="insta__handle" href={compte} target="_blank" rel="noopener noreferrer">@cabinet.curiosites.lyon</a>
    </div>
    <div class="insta__row reveal">
      {posts.map((p) => (
        <a class="c" href={`${compte}${p.lien}/`} aria-label="Voir la publication sur Instagram" target="_blank" rel="noopener noreferrer"><img src={`/assets/insta/${p.img}`} alt="" loading="lazy" width="640" height="640" /></a>
      ))}
    </div>
    <a class="insta__cta reveal" href={compte} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
      Suivre le Cabinet
    </a>
  </div>
</section>
