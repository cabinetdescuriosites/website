---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Instagram from '../components/Instagram.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  active?: string;
  inner?: boolean;
}
const {
  title,
  description = "Cabinet des Curiosités — objets chinés, pièces uniques et curiosités sélectionnées avec soin à Lyon.",
  active = "",
  inner = false,
} = Astro.props;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400;1,500&family=Pinyon+Script&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body class={inner ? "inner" : ""}>
  <div class="site">
    <Header active={active} />
    <slot />
    <Instagram />
    <Footer />
  </div>

  <script>
    // mobile nav
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('.hdr__toggle')) document.querySelector('.hdr__nav')?.classList.toggle('open');
      if (t.closest('.hdr__nav a')) document.querySelector('.hdr__nav')?.classList.remove('open');
    });
    // header: solid on scroll (only when overlaying a hero)
    const h = document.querySelector('.site-header');
    if (h && !document.body.classList.contains('inner')) {
      const onScroll = () => h.classList.toggle('stuck', window.scrollY > 160);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    // scroll reveal
    const io = new IntersectionObserver((es) => {
      es.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach((el, i) => {
      (el as HTMLElement).style.transitionDelay = (Math.min(i % 3, 2) * 90) + 'ms';
      io.observe(el);
    });
    // shop filters
    const fb = document.querySelector('.filters');
    fb?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      fb.querySelectorAll('button').forEach((x) => x.classList.remove('on'));
      b.classList.add('on');
      const c = (b as HTMLElement).dataset.filter;
      document.querySelectorAll('[data-cat]').forEach((card) => {
        const el = card as HTMLElement;
        el.classList.toggle('is-hidden', !(c === 'all' || el.dataset.cat === c));
      });
    });
    // demo buttons
    document.querySelectorAll('[data-demo]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const n = el as HTMLElement;
        if (!n.dataset.orig) n.dataset.orig = n.textContent || '';
        n.textContent = n.dataset.demo || '';
        setTimeout(() => { n.textContent = n.dataset.orig || ''; }, 2200);
      });
    });
    // demo forms
    document.querySelectorAll('form[data-demo-form]').forEach((form) => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const f = form as HTMLFormElement;
        let note = f.querySelector('[data-note]') as HTMLElement | null;
        if (!note) {
          note = document.createElement('p');
          note.setAttribute('data-note', '');
          note.style.cssText = 'margin-top:14px;color:var(--gold);font-size:.8rem;letter-spacing:.06em';
          f.appendChild(note);
        }
        note.textContent = f.dataset.demoForm || 'Merci !';
        f.reset();
      });
    });
  </script>
</body>
</html>
