---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Instagram from '../components/Instagram.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  active?: string;
  inner?: boolean;
}
const {
  title,
  description = "Cabinet des Curiosités — objets chinés, pièces uniques et curiosités sélectionnées avec soin à Lyon.",
  image = "/assets/partage-cabinet.jpg",
  active = "",
  inner = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
// Toutes les images de partage sont produites au gabarit 1200x628 en JPEG.
const partageStandard = image.startsWith("/assets/partage");
const ogAlt = image.startsWith("/assets/partage/")
  ? `${title.split(" — ")[0]} — Cabinet des Curiosités`
  : "Des mains ouvrent un tiroir ancien garni de jumelles de théâtre, d’une montre de gousset et de petits objets chinés";
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Cabinet des Curiosités" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {partageStandard && <meta property="og:image:type" content="image/jpeg" />}
  {partageStandard && <meta property="og:image:width" content="1200" />}
  {partageStandard && <meta property="og:image:height" content="628" />}
  <meta property="og:image:alt" content={ogAlt} />
  <meta property="og:locale" content="fr_FR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogAlt} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400;1,500&family=Pinyon+Script&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script is:inline>
    // Après une invitation ou une réinitialisation, on renvoie Stéphanie vers son espace.
    window.netlifyIdentity?.on("init", (user) => {
      if (!user) window.netlifyIdentity.on("login", () => { document.location.href = "/admin/"; });
    });
  </script>
</head>
<body class={inner ? "inner" : ""} id="top">
  <div class="site">
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header active={active} />
    <main id="contenu">
      <slot />
    </main>
    <Instagram />
    <Footer />
  </div>

  <script>
    // Le menu hors-écran ne doit être ni focusable ni annoncé tant qu'il est fermé.
    const mobileNav = window.matchMedia('(max-width:980px)');
    const setMenu = (opened: boolean) => {
      const nav = document.querySelector('.hdr__nav');
      const toggle = document.querySelector('.hdr__toggle');
      if (!nav) return;
      nav.classList.toggle('open', opened);
      const hidden = mobileNav.matches && !opened;
      nav.toggleAttribute('inert', hidden);
      if (hidden) nav.setAttribute('aria-hidden', 'true');
      else nav.removeAttribute('aria-hidden');
      toggle?.setAttribute('aria-expanded', String(opened));
      toggle?.setAttribute('aria-label', opened ? 'Fermer le menu' : 'Ouvrir le menu');
      document.body.classList.toggle('menu-open', opened);
    };
    const syncMenu = () => setMenu(document.querySelector('.hdr__nav')?.classList.contains('open') ?? false);
    mobileNav.addEventListener('change', () => setMenu(false));
    document.addEventListener('astro:page-load', syncMenu);
    syncMenu();

    // Écouteurs globaux (document/window survivent aux View Transitions) — une seule fois.
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const toggle = t.closest('.hdr__toggle') as HTMLButtonElement | null;
      if (toggle) {
        setMenu(!(document.querySelector('.hdr__nav')?.classList.contains('open') ?? false));
      }
      if (t.closest('[data-menu-close]') || t.closest('.hdr__nav a')) {
        setMenu(false);
      }
      // demo achat
      const demo = t.closest('[data-demo]') as HTMLElement | null;
      if (demo) {
        e.preventDefault();
        if (!demo.dataset.orig) demo.dataset.orig = demo.textContent || '';
        demo.textContent = demo.dataset.demo || '';
        setTimeout(() => { demo.textContent = demo.dataset.orig || ''; }, 2200);
      }
      // filtres boutique
      const b = t.closest('.filters button') as HTMLElement | null;
      if (b) {
        b.closest('.filters')!.querySelectorAll('button').forEach((x) => x.classList.remove('on'));
        b.closest('.filters')!.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', 'false'));
        b.classList.add('on');
        b.setAttribute('aria-pressed', 'true');
        const c = b.dataset.filter;
        document.querySelectorAll('[data-cat]').forEach((card) => {
          const el = card as HTMLElement;
          el.classList.toggle('is-hidden', !(c === 'all' || (c === 'nouveautes' ? el.dataset.new === 'true' : el.dataset.cat === c)));
        });
      }
      const thumb = t.closest('[data-product-thumb]') as HTMLButtonElement | null;
      if (thumb) {
        const gallery = thumb.closest('[data-product-gallery]');
        const main = gallery?.querySelector('[data-product-main]') as HTMLImageElement | null;
        if (main && thumb.dataset.productThumb && main.src !== thumb.dataset.productThumb) {
          const next = thumb.dataset.productThumb;
          // Fondu : on masque, on remplace une fois la nouvelle image prête, on révèle.
          const swap = new Image();
          swap.onload = () => {
            main.src = next;
            requestAnimationFrame(() => main.classList.remove('is-swapping'));
          };
          main.classList.add('is-swapping');
          swap.src = next;
          gallery?.querySelectorAll('[data-product-thumb]').forEach((x) => x.classList.remove('is-active'));
          thumb.classList.add('is-active');
        }
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      setMenu(false);
    });
    (() => {
      const requested = new URLSearchParams(window.location.search).get('categorie');
      if (!requested) return;
      const button = document.querySelector(`.filters button[data-filter="${CSS.escape(requested)}"]`) as HTMLButtonElement | null;
      if (!button) return;
      button.closest('.filters')?.querySelectorAll('button').forEach((x) => {
        x.classList.toggle('on', x === button);
        x.setAttribute('aria-pressed', String(x === button));
      });
      document.querySelectorAll('[data-cat]').forEach((card) => {
        const el = card as HTMLElement;
        el.classList.toggle('is-hidden', !(requested === 'nouveautes' ? el.dataset.new === 'true' : el.dataset.cat === requested));
      });
    })();
    document.addEventListener('submit', (e) => {
      const f = (e.target as HTMLElement).closest('form[data-demo-form]') as HTMLFormElement | null;
      if (!f) return;
      e.preventDefault();
      let note = f.querySelector('[data-note]') as HTMLElement | null;
      if (!note) {
        note = document.createElement('p');
        note.setAttribute('data-note', '');
        note.style.cssText = 'margin-top:14px;color:var(--gold);font-size:.8rem;letter-spacing:.06em';
        f.appendChild(note);
      }
      note.textContent = f.dataset.demoForm || 'Merci !';
      f.reset();
    });
    const onScroll = () => {
      const h = document.querySelector('.site-header');
      if (h) h.classList.toggle('stuck', window.scrollY > 48);
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    onScroll();
  </script>
</body>
</html>
