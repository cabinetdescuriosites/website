---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Instagram from '../components/Instagram.astro';
import Footer from '../components/Footer.astro';
import OpeningCurtain from '../components/OpeningCurtain.astro';

interface Props {
  title: string;
  description?: string;
  active?: string;
  inner?: boolean;
}
const {
  title,
  description = "Cabinet des Curiosités — objets chinés, pièces uniques et curiosités sélectionnées avec soin à Lyon.",
  active = "",
  inner = false,
} = Astro.props;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400;1,500&family=Pinyon+Script&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
  <ViewTransitions />
</head>
<body class={inner ? "inner" : ""}>
  {!inner && <OpeningCurtain />}
  <div class="site">
    <Header active={active} />
    <slot />
    <Instagram />
    <Footer />
  </div>

  <script>
    // Écouteurs globaux (document/window survivent aux View Transitions) — une seule fois.
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const toggle = t.closest('.hdr__toggle') as HTMLButtonElement | null;
      if (toggle) {
        const nav = document.querySelector('.hdr__nav');
        const opened = nav?.classList.toggle('open') ?? false;
        toggle.setAttribute('aria-expanded', String(opened));
        toggle.setAttribute('aria-label', opened ? 'Fermer le menu' : 'Ouvrir le menu');
        document.body.classList.toggle('menu-open', opened);
      }
      if (t.closest('[data-menu-close]')) {
        document.querySelector('.hdr__nav')?.classList.remove('open');
        document.querySelector('.hdr__toggle')?.setAttribute('aria-expanded', 'false');
        document.querySelector('.hdr__toggle')?.setAttribute('aria-label', 'Ouvrir le menu');
        document.body.classList.remove('menu-open');
      }
      if (t.closest('.hdr__nav a')) {
        document.querySelector('.hdr__nav')?.classList.remove('open');
        document.querySelector('.hdr__toggle')?.setAttribute('aria-expanded', 'false');
        document.querySelector('.hdr__toggle')?.setAttribute('aria-label', 'Ouvrir le menu');
        document.body.classList.remove('menu-open');
      }
      // demo achat
      const demo = t.closest('[data-demo]') as HTMLElement | null;
      if (demo) {
        e.preventDefault();
        if (!demo.dataset.orig) demo.dataset.orig = demo.textContent || '';
        demo.textContent = demo.dataset.demo || '';
        setTimeout(() => { demo.textContent = demo.dataset.orig || ''; }, 2200);
      }
      // filtres boutique
      const b = t.closest('.filters button') as HTMLElement | null;
      if (b) {
        b.closest('.filters')!.querySelectorAll('button').forEach((x) => x.classList.remove('on'));
        b.closest('.filters')!.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', 'false'));
        b.classList.add('on');
        b.setAttribute('aria-pressed', 'true');
        const c = b.dataset.filter;
        document.querySelectorAll('[data-cat]').forEach((card) => {
          const el = card as HTMLElement;
          el.classList.toggle('is-hidden', !(c === 'all' || (c === 'nouveautes' ? el.dataset.new === 'true' : el.dataset.cat === c)));
        });
      }
      const thumb = t.closest('[data-product-thumb]') as HTMLButtonElement | null;
      if (thumb) {
        const gallery = thumb.closest('[data-product-gallery]');
        const main = gallery?.querySelector('[data-product-main]') as HTMLImageElement | null;
        if (main && thumb.dataset.productThumb) {
          main.src = thumb.dataset.productThumb;
          gallery?.querySelectorAll('[data-product-thumb]').forEach((x) => x.classList.remove('is-active'));
          thumb.classList.add('is-active');
        }
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelector('.hdr__nav')?.classList.remove('open');
      document.querySelector('.hdr__toggle')?.setAttribute('aria-expanded', 'false');
      document.querySelector('.hdr__toggle')?.setAttribute('aria-label', 'Ouvrir le menu');
      document.body.classList.remove('menu-open');
    });
    document.addEventListener('astro:page-load', () => {
      const requested = new URLSearchParams(window.location.search).get('categorie');
      if (!requested) return;
      const button = document.querySelector(`.filters button[data-filter="${CSS.escape(requested)}"]`) as HTMLButtonElement | null;
      if (!button) return;
      button.closest('.filters')?.querySelectorAll('button').forEach((x) => {
        x.classList.toggle('on', x === button);
        x.setAttribute('aria-pressed', String(x === button));
      });
      document.querySelectorAll('[data-cat]').forEach((card) => {
        const el = card as HTMLElement;
        el.classList.toggle('is-hidden', !(requested === 'nouveautes' ? el.dataset.new === 'true' : el.dataset.cat === requested));
      });
    });
    document.addEventListener('submit', (e) => {
      const f = (e.target as HTMLElement).closest('form[data-demo-form]') as HTMLFormElement | null;
      if (!f) return;
      e.preventDefault();
      let note = f.querySelector('[data-note]') as HTMLElement | null;
      if (!note) {
        note = document.createElement('p');
        note.setAttribute('data-note', '');
        note.style.cssText = 'margin-top:14px;color:var(--gold);font-size:.8rem;letter-spacing:.06em';
        f.appendChild(note);
      }
      note.textContent = f.dataset.demoForm || 'Merci !';
      f.reset();
    });
    const onScroll = () => {
      const h = document.querySelector('.site-header');
      if (h) h.classList.toggle('stuck', window.scrollY > 120);
      const portrait = document.querySelector('[data-portrait-parallax]') as HTMLElement | null;
      if (portrait && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const rect = portrait.getBoundingClientRect();
        const progress = Math.max(0, Math.min(1, (window.innerHeight - rect.top) / (window.innerHeight + rect.height)));
        portrait.style.setProperty('--portrait-shift', `${(progress - .5) * 12}px`);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    // Ré-initialisation à chaque page (premier chargement inclus, via View Transitions).
    document.addEventListener('astro:page-load', () => {
      onScroll();
      const io = new IntersectionObserver((es) => {
        es.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal:not(.in)').forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay = (Math.min(i % 3, 2) * 60) + 'ms';
        io.observe(el);
      });
    });
  </script>
</body>
</html>
